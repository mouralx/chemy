    <!-- Hidden Coordinate Data for 3D Viewer & Exporters -->
    <textarea id="rawPdbData" class="hidden">@Model.PdbContent</textarea>
    <textarea id="rawXyzData" class="hidden">@Model.XyzContent</textarea>
    <textarea id="rawMolData" class="hidden">@Model.MolContent</textarea>
    <textarea id="rawPlanarPdbData" class="hidden">@Model.PlanarPdbContent</textarea>
    <textarea id="rawPlanarXyzData" class="hidden">@Model.PlanarXyzContent</textarea>
    <textarea id="rawPlanarMolData" class="hidden">@Model.PlanarMolContent</textarea>

    <!-- ===================================================================== -->
    <!-- 3. COMPREHENSIVE WORKSTATION SCRIPT                                   -->
    <!-- ===================================================================== -->
    <script>
        // --------------------------------------------------------------------
        // Global State & 3D Viewer Initialization
        // --------------------------------------------------------------------
        let viewer = null;
        let isSpinning = false;
        let activeCategory = 'all';
        let activeTool = 'balancer';
        let currentSpatialMode = '3d'; // '3d' or 'flat'

        // 50-Compound Preset Database
        const catalogData = [
            { name: "Water", formula: "H2O", category: "solvents", tags: "Polar solvent" },
            { name: "Methane", formula: "CH4", category: "organics", tags: "Hydrocarbon" },
            { name: "Carbon Dioxide", formula: "CO2", category: "inorganics", tags: "Greenhouse gas" },
            { name: "Aspirin", formula: "CC(=O)Oc1ccccc1C(=O)O", category: "drugs", tags: "NSAID Analgesic" },
            { name: "Caffeine", formula: "CN1C=NC2=C1C(=O)N(C(=O)N2C)C", category: "drugs", tags: "CNS Stimulant" },
            { name: "Paracetamol", formula: "CC(=O)Nc1ccc(O)cc1", category: "drugs", tags: "Analgesic" },
            { name: "Ibuprofen", formula: "CC(C)Cc1ccc(cc1)C(C)C(=O)O", category: "drugs", tags: "NSAID Anti-inflammatory" },
            { name: "Cocaine", formula: "CN1C2CCC1C(C(=O)OC)C(OC(=O)c1ccccc1)C2", category: "toxins", tags: "Tropane Alkaloid" },
            { name: "Morphine", formula: "CN1CCC23C4C1CC5=C2C(=C(C=C5)O)OC3C(C=C4)O", category: "drugs", tags: "Opioid Analgesic" },
            { name: "PFOA (PFAS)", formula: "OC(=O)C(F)(F)C(F)(F)C(F)(F)C(F)(F)C(F)(F)C(F)(F)C(F)(F)F", category: "toxins", tags: "Forever Chemical C8HF15O2" },
            { name: "PFOS (PFAS)", formula: "OS(=O)(=O)C(F)(F)C(F)(F)C(F)(F)C(F)(F)C(F)(F)C(F)(F)C(F)(F)C(F)(F)F", category: "toxins", tags: "Perfluorooctanesulfonate C8HF17O3S" },
            { name: "Glucose", formula: "OCC1OC(O)C(O)C(O)C1O", category: "biomolecules", tags: "Carbohydrate Sugar C6H12O6" },
            { name: "ATP", formula: "c1nc(c2c(n1)n(cn2)C3C(C(C(O3)COP(=O)(O)OP(=O)(O)OP(=O)(O)O)O)O)N", category: "biomolecules", tags: "Cellular Energy C10H16N5O13P3" },
            { name: "Ethanol", formula: "CCO", category: "solvents", tags: "Alcohol" },
            { name: "Acetone", formula: "CC(=O)C", category: "solvents", tags: "Ketone Solvent" },
            { name: "Benzene", formula: "c1ccccc1", category: "organics", tags: "Aromatic Ring" },
            { name: "PET Monomer", formula: "c1cc(ccc1C(=O)OCCO)C(=O)OCCO", category: "polymers", tags: "Plastic Precursor C10H8O4" },
            { name: "Nicotine", formula: "CN1CCCC1c1cccnc1", category: "toxins", tags: "Alkaloid Stimulant" },
            { name: "Sulfuric Acid", formula: "H2SO4", category: "inorganics", tags: "Mineral Acid" },
            { name: "Ammonia", formula: "NH3", category: "inorganics", tags: "Hydride Base" }
        ];

        window.addEventListener('DOMContentLoaded', () => {
            init3DViewer();
            renderCatalog();
            loadDoc('api');

            const savedView = localStorage.getItem('chemy_workstation_view') || '3d';
            setWorkstationView(savedView);
            checkApiHealth();
            setInterval(checkApiHealth, 8000);
        });

        window.addEventListener('resize', () => {
            if (viewer) {
                viewer.resize();
                viewer.zoomTo();
                viewer.render();
            }
        });

        function init3DViewer() {
            const host = document.getElementById('viewer3d');
            if (!host) return;
            viewer = $3Dmol.createViewer(host, { backgroundColor: '#070a14', antialias: true });
            reload3DModel();
        }

        function setWorkstationView(view) {
            localStorage.setItem('chemy_workstation_view', view);
            const v3d = document.getElementById('viewer3d');
            const v2d = document.getElementById('viewer2d');
            if (view === '3d') {
                v3d.classList.remove('hidden');
                v2d.classList.add('hidden');
            } else {
                v3d.classList.add('hidden');
                v2d.classList.remove('hidden');
            }
            setTimeout(autoFitViewer, 50);
        }

        function downloadSkeletalSvg() {
            const svgHost = document.getElementById('skeletalSvgContainer');
            if (!svgHost) return;
            const svgContent = svgHost.innerHTML.trim();
            const blob = new Blob([svgContent], { type: 'image/svg+xml;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `@(Model.ChemicalFormula)_skeletal.svg`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function setSpatialMode(mode) {
            currentSpatialMode = mode;
            const btn3D = document.getElementById('spatialMode3D');
            const btnFlat = document.getElementById('spatialModeFlat');

            if (mode === '3d') {
                btn3D.className = 'px-2 py-0.5 rounded bg-sky-600 text-white font-semibold transition';
                btnFlat.className = 'px-2 py-0.5 rounded text-slate-400 hover:text-white transition';
            } else {
                btnFlat.className = 'px-2 py-0.5 rounded bg-sky-600 text-white font-semibold transition';
                btn3D.className = 'px-2 py-0.5 rounded text-slate-400 hover:text-white transition';
            }
            reload3DModel();
            if (mode === 'flat') {
                snapFrontView();
            }
        }

        let currentHuckelData = null;
        let showLabels = false;

        async function fetchHuckelDataIfNeeded(formula) {
            try {
                const res = await fetch('/api/v1/quantum/huckel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ formula: formula, betaEv: 2.71 })
                });
                if (res.ok) {
                    currentHuckelData = await res.json();
                } else {
                    currentHuckelData = null;
                }
            } catch {
                currentHuckelData = null;
            }
        }

        function interpolateColor(color1, color2, factor) {
            const c1 = parseInt(color1.slice(1), 16);
            const c2 = parseInt(color2.slice(1), 16);
            const r1 = (c1 >> 16) & 255, g1 = (c1 >> 8) & 255, b1 = c1 & 255;
            const r2 = (c2 >> 16) & 255, g2 = (c2 >> 8) & 255, b2 = c2 & 255;
            const r = Math.round(r1 + factor * (r2 - r1));
            const g = Math.round(g1 + factor * (g2 - g1));
            const b = Math.round(b1 + factor * (b2 - b1));
            return `#${((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1)}`;
        }

        function getAtomStyle(style, hexColor) {
            switch (style) {
                case 'stick': return { stick: { radius: 0.18, color: hexColor } };
                case 'sphere': return { sphere: { scale: 0.85, color: hexColor } };
                case 'wireframe': return { line: { linewidth: 2, color: hexColor } };
                case 'ballAndStick':
                default: return { stick: { radius: 0.14, color: hexColor }, sphere: { scale: 0.28, color: hexColor } };
            }
        }

        function reload3DModel() {
            if (!viewer) return;
            viewer.clear();

            const isFlat = (currentSpatialMode === 'flat');
            const pdbData = document.getElementById(isFlat ? 'rawPlanarPdbData' : 'rawPdbData').value;
            const xyzData = document.getElementById(isFlat ? 'rawPlanarXyzData' : 'rawXyzData').value;

            if (pdbData && pdbData.trim().length > 0) {
                viewer.addModel(pdbData, "pdb");
            } else if (xyzData && xyzData.trim().length > 0) {
                viewer.addModel(xyzData, "xyz");
            }

            applyRenderStyle();
            autoFitViewer();
        }

        function applyRenderStyle() {
            if (!viewer) return;
            const style = document.getElementById('renderStyleSelect').value;
            const colorMode = document.getElementById('colorModeSelect').value;
            const surfaceMode = document.getElementById('surfaceSelect').value;

            viewer.removeAllSurfaces();
            viewer.removeAllLabels();

            // 1. Base Geometry Representation
            switch (style) {
                case 'stick':
                    viewer.setStyle({}, { stick: { radius: 0.18 } });
                    break;
                case 'sphere':
                    viewer.setStyle({}, { sphere: { scale: 0.85 } });
                    break;
                case 'wireframe':
                    viewer.setStyle({}, { line: { linewidth: 2 } });
                    break;
                case 'ballAndStick':
                default:
                    viewer.setStyle({}, { stick: { radius: 0.14 }, sphere: { scale: 0.28 } });
                    break;
            }

            // 2. Element Colors or Quantum Color Mapping
            if (colorMode === 'cpk' || !currentHuckelData) {
                viewer.setColorByElement({}, {
                    'H': '#ffffff',
                    'C': '#94a3b8',
                    'O': '#f87171',
                    'N': '#38bdf8',
                    'S': '#facc15',
                    'P': '#fb923c',
                    'Cl': '#4ade80',
                    'F': '#22d3ee',
                    'Br': '#b91c1c',
                    'I': '#7e22ce'
                });
            } else if (colorMode === 'homo' && currentHuckelData) {
                const homo = currentHuckelData.orbitals.find(o => o.orbitalIndex === currentHuckelData.homoIndex);
                const maxCoeff = homo ? Math.max(...homo.coefficients.map(c => c * c), 0.01) : 0.01;
                viewer.selectedAtoms().forEach((atom, idx) => {
                    const fuk = currentHuckelData.fukuiIndices.find(f => f.atomIndex === idx);
                    let val = fuk ? fuk.electrophilicAttackIndex : 0;
                    let t = Math.min(1.0, Math.max(0.0, val / maxCoeff));
                    let hex = interpolateColor('#1e293b', '#00f2fe', t);
                    viewer.setStyle({ serial: atom.serial || idx + 1 }, getAtomStyle(style, hex));
                });
            } else if (colorMode === 'lumo' && currentHuckelData) {
                const lumo = currentHuckelData.orbitals.find(o => o.orbitalIndex === currentHuckelData.lumoIndex);
                const maxCoeff = lumo ? Math.max(...lumo.coefficients.map(c => c * c), 0.01) : 0.01;
                viewer.selectedAtoms().forEach((atom, idx) => {
                    const fuk = currentHuckelData.fukuiIndices.find(f => f.atomIndex === idx);
                    let val = fuk ? fuk.nucleophilicAttackIndex : 0;
                    let t = Math.min(1.0, Math.max(0.0, val / maxCoeff));
                    let hex = interpolateColor('#1e293b', '#f43f5e', t);
                    viewer.setStyle({ serial: atom.serial || idx + 1 }, getAtomStyle(style, hex));
                });
            } else if (colorMode === 'charge' && currentHuckelData) {
                viewer.selectedAtoms().forEach((atom, idx) => {
                    const c = currentHuckelData.atomCharges.find(ac => ac.atomIndex === idx);
                    let hex = '#64748b';
                    if (c) {
                        if (c.netCharge < -0.01) {
                            let t = Math.min(1.0, Math.abs(c.netCharge) / 0.5);
                            hex = interpolateColor('#64748b', '#ef4444', t);
                        } else if (c.netCharge > 0.01) {
                            let t = Math.min(1.0, c.netCharge / 0.5);
                            hex = interpolateColor('#64748b', '#0ea5e9', t);
                        }
                    }
                    viewer.setStyle({ serial: atom.serial || idx + 1 }, getAtomStyle(style, hex));
                });
            } else if (colorMode === 'fukui' && currentHuckelData) {
                viewer.selectedAtoms().forEach((atom, idx) => {
                    const fuk = currentHuckelData.fukuiIndices.find(f => f.atomIndex === idx);
                    let hex = '#64748b';
                    if (fuk) {
                        let t = Math.min(1.0, fuk.radicalAttackIndex / 0.5);
                        hex = interpolateColor('#64748b', '#10b981', t);
                    }
                    viewer.setStyle({ serial: atom.serial || idx + 1 }, getAtomStyle(style, hex));
                });
            }

            // 3. Molecular Surface Mesh
            if (surfaceMode !== 'none') {
                let surfType = $3Dmol.SurfaceType.VDW;
                if (surfaceMode === 'sas') surfType = $3Dmol.SurfaceType.SAS;
                if (surfaceMode === 'ses') surfType = $3Dmol.SurfaceType.SES;
                viewer.addSurface(surfType, {
                    opacity: 0.60,
                    color: (colorMode === 'homo' ? '#00f2fe' : (colorMode === 'lumo' ? '#f43f5e' : '#38bdf8'))
                });
            }

            // 4. 3D Floating Labels
            if (showLabels) {
                const atoms = viewer.selectedAtoms();
                atoms.forEach(atom => {
                    if (atom.elem !== 'H' || atoms.length < 15) {
                        viewer.addLabel(`${atom.elem}${atom.serial || ''}`, {
                            position: { x: atom.x, y: atom.y, z: atom.z },
                            backgroundColor: 'rgba(15, 23, 42, 0.85)',
                            fontColor: '#38bdf8',
                            fontSize: 10,
                            inFront: true
                        });
                    }
                });
            }

            viewer.render();
        }

        function changeRenderStyle() { applyRenderStyle(); }

        async function changeColorMode() {
            const mode = document.getElementById('colorModeSelect').value;
            if (mode !== 'cpk' && !currentHuckelData) {
                const formula = document.querySelector('input[name="Formula"]')?.value || "@Model.Formula";
                await fetchHuckelDataIfNeeded(formula);
            }
            applyRenderStyle();
        }

        function changeSurfaceMode() { applyRenderStyle(); }

        function toggleLabels() {
            showLabels = !showLabels;
            const btn = document.getElementById('labelsBtn');
            if (btn) {
                if (showLabels) {
                    btn.classList.add('bg-sky-600', 'text-white');
                    btn.classList.remove('bg-slate-800', 'text-slate-300');
                } else {
                    btn.classList.remove('bg-sky-600', 'text-white');
                    btn.classList.add('bg-slate-800', 'text-slate-300');
                }
            }
            applyRenderStyle();
        }

        function autoFitViewer() {
            if (!viewer) return;
            viewer.zoomTo();
            viewer.render();
        }

        function snapFrontView() {
            if (!viewer) return;
            viewer.setCameraDirection([0, 0, 1]);
            viewer.zoomTo();
            viewer.render();
        }

        function toggleSpin() {
            isSpinning = !isSpinning;
            const btn = document.getElementById('spinBtn');
            if (isSpinning) {
                btn.classList.add('bg-sky-600', 'text-white');
                btn.classList.remove('bg-slate-800', 'text-slate-300');
                startSpinLoop();
            } else {
                btn.classList.remove('bg-sky-600', 'text-white');
                btn.classList.add('bg-slate-800', 'text-slate-300');
                cancelAnimationFrame(spinReqId);
            }
        }

        function startSpinLoop() {
            if (!isSpinning || !viewer) return;
            viewer.rotate(0.6, "y");
            viewer.render();
            spinReqId = requestAnimationFrame(startSpinLoop);
        }

        async function checkApiHealth() {
            const indicator = document.getElementById('apiStatusIndicator');
            const badge = document.getElementById('apiStatusBadge');
            try {
                const res = await fetch('/healthz');
                if (res.ok) {
                    if (indicator) indicator.className = "w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]";
                    if (badge) badge.innerText = "API ONLINE (21/21)";
                } else {
                    if (indicator) indicator.className = "w-2 h-2 rounded-full bg-amber-400";
                    if (badge) badge.innerText = "DEGRADED (CORE FALLBACK)";
                }
            } catch {
                if (indicator) indicator.className = "w-2 h-2 rounded-full bg-rose-500";
                if (badge) badge.innerText = "OFFLINE (CORE FALLBACK)";
            }
        }

        async function loadMoleculeLive(formula, shape = 'Auto') {
            try {
                const [res3d, resPlanar] = await Promise.all([
                    fetch('/api/v1/geometry/3d', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ formula: formula, overrideShape: shape })
                    }),
                    fetch('/api/v1/geometry/planar-3d', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ formula: formula })
                    })
                ]);

                if (res3d.ok) {
                    const data3d = await res3d.json();
                    const dataPlanar = resPlanar.ok ? await resPlanar.json() : null;

                    document.getElementById('rawPdbData').value = data3d.pdbFormat || '';
                    document.getElementById('rawXyzData').value = data3d.xyzFormat || '';
                    document.getElementById('rawMolData').value = data3d.molFormat || '';

                    if (dataPlanar) {
                        document.getElementById('rawPlanarPdbData').value = dataPlanar.pdbFormat || '';
                        document.getElementById('rawPlanarXyzData').value = dataPlanar.xyzFormat || '';
                        document.getElementById('rawPlanarMolData').value = dataPlanar.molFormat || '';
                        if (dataPlanar.skeletalSvg) {
                            document.getElementById('skeletalSvgContainer').innerHTML = dataPlanar.skeletalSvg;
                        }
                    } else if (data3d.skeletalSvg) {
                        document.getElementById('skeletalSvgContainer').innerHTML = data3d.skeletalSvg;
                    }

                    const name = data3d.moleculeName || formula;
                    const chemFormula = data3d.chemicalFormula || formula;
                    document.getElementById('currentMoleculeName').innerText = name;
                    document.getElementById('currentFormulaBadge').innerText = chemFormula;
                    document.getElementById('metaHillFormula').innerText = chemFormula;
                    document.getElementById('metaMolarMass').innerHTML = `${(data3d.molecularWeight || 0).toFixed(3)} <span class="text-[10px] text-slate-400">g/mol</span>`;
                    document.getElementById('metaVseprShape').innerText = data3d.vseprShape || 'Auto';
                    document.getElementById('metaBondAngle').innerText = `${(data3d.idealBondAngleDegrees || 0).toFixed(1)}°`;

                    const formulaInput = document.querySelector('input[name="Formula"]');
                    if (formulaInput) formulaInput.value = formula;
                    const huckelInput = document.getElementById('huckelFormulaInput');
                    if (huckelInput) huckelInput.value = chemFormula;
                    const specInput = document.getElementById('specFormulaInput');
                    if (specInput) specInput.value = chemFormula;
                    const evolverInput = document.getElementById('evolverInput');
                    if (evolverInput) evolverInput.value = formula;
                    const admetInput = document.getElementById('admetInput');
                    if (admetInput) admetInput.value = formula;

                    currentHuckelData = null;
                    const colorMode = document.getElementById('colorModeSelect')?.value;
                    if (colorMode && colorMode !== 'cpk') {
                        await fetchHuckelDataIfNeeded(formula);
                    }

                    reload3DModel();
                    history.pushState(null, '', `/?Formula=${encodeURIComponent(formula)}`);
                    return;
                }
            } catch (err) {
                console.warn('Live API call failed, falling back to full navigation:', err);
            }
            window.location.href = `/?Formula=${encodeURIComponent(formula)}`;
        }

        function switchMainView(viewName) {
            ['workstation', 'docs', 'coderef', 'disclaimer'].forEach(v => {
                document.getElementById(`view-${v}`).classList.add('hidden');
                const navBtn = document.getElementById(`mainnav-${v}`);
                if (navBtn) navBtn.classList.remove('nav-btn-active');
            });
            document.getElementById(`view-${viewName}`).classList.remove('hidden');
            const activeNav = document.getElementById(`mainnav-${viewName}`);
            if (activeNav) activeNav.classList.add('nav-btn-active');
            if (viewName === 'workstation') {
                setTimeout(autoFitViewer, 50);
            }
        }

        function renderCatalog() {
            const grid = document.getElementById('catalogGrid');
            const search = (document.getElementById('catalogSearchInput').value || '').toLowerCase();
            grid.innerHTML = '';
            const filtered = catalogData.filter(c => {
                const matchCat = (activeCategory === 'all' || c.category === activeCategory);
                const matchSearch = c.name.toLowerCase().includes(search) || c.formula.toLowerCase().includes(search) || c.tags.toLowerCase().includes(search);
                return matchCat && matchSearch;
            });
            filtered.forEach(c => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.onclick = () => loadMoleculeLive(c.formula);
