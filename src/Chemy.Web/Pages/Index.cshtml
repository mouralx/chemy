@page
@model IndexModel
@using System.Text.Json
@{
    Layout = null;
    ViewData["Title"] = "Chemy Scientific Workspace";
    var bootstrap = new
    {
        formula = Model.Formula,
        moleculeName = Model.MoleculeName,
        chemicalFormula = Model.ChemicalFormula,
        vseprShape = Model.VseprShape,
        idealBondAngleDegrees = Model.IdealBondAngleDegrees,
        molecularWeight = Model.MolecularWeight,
        totalAtomCount = Model.TotalAtomCount,
        elementsPresent = Model.ElementsPresent,
        functionalGroups = Model.FunctionalGroups,
        pdbContent = Model.PdbContent,
        xyzContent = Model.XyzContent,
        molContent = Model.MolContent,
        planarPdbContent = Model.PlanarPdbContent,
        planarXyzContent = Model.PlanarXyzContent,
        planarMolContent = Model.PlanarMolContent,
        skeletalSvgContent = Model.SkeletalSvgContent,
        isApiConnected = Model.IsApiConnected,
        errorMessage = Model.ErrorMessage,
        documentation = Model.DocumentationMap
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1f36" />
    <title>Chemy Scientific Workspace</title>
    <script>
        (() => {
            try {
                const storedTheme = localStorage.getItem("chemy-theme");
                const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                document.documentElement.dataset.theme = storedTheme || preferredTheme;
            } catch {
                document.documentElement.dataset.theme = "light";
            }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://3dmol.org/build/3Dmol-min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script id="chemy-bootstrap" type="application/json">@Html.Raw(JsonSerializer.Serialize(bootstrap))</script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar" aria-label="Primary navigation">
            <div class="brand-block">
                <div class="brand-mark" aria-hidden="true"><span class="brand-orbit"></span><span>C</span></div>
                <div><strong>Chemy</strong><span>Scientific workspace</span></div>
            </div>

            <nav class="primary-nav">
                <p class="nav-label">Workspace</p>
                <button class="nav-item is-active" type="button" data-view-target="studio">
                    <span class="nav-icon">01</span><span><strong>Molecular studio</strong><small>Visualize and inspect</small></span>
                </button>
                <button class="nav-item" type="button" data-view-target="tools">
                    <span class="nav-icon">02</span><span><strong>Calculation tools</strong><small>Complete API surface</small></span><span class="nav-count">24</span>
                </button>
                <p class="nav-label">Knowledge</p>
                <button class="nav-item" type="button" data-view-target="docs">
                    <span class="nav-icon">03</span><span><strong>Documentation</strong><small>Guides and evidence</small></span>
                </button>
                <button class="nav-item" type="button" data-view-target="code">
                    <span class="nav-icon">04</span><span><strong>Code reference</strong><small>C# public surface</small></span>
                </button>
                <button class="nav-item" type="button" data-view-target="scope">
                    <span class="nav-icon">05</span><span><strong>Scientific scope</strong><small>Evidence and boundaries</small></span>
                </button>
            </nav>

            <div class="sidebar-footer">
                <div class="service-state" id="serviceState">
                    <span class="status-dot @(Model.IsApiConnected ? "is-online" : "is-offline")" id="apiStatusIndicator"></span>
                    <div><strong id="apiStatusText">@(Model.IsApiConnected ? "API operational" : "Core fallback active")</strong><span id="apiStatusDetail">Chemy.Api · localhost:5192</span></div>
                    <button type="button" class="icon-button" id="refreshHealthButton" aria-label="Refresh API status">↻</button>
                </div>
                <div class="sidebar-links">
                    <a href="http://localhost:5192/scalar/v1" target="_blank" rel="noopener">Scalar API <span>↗</span></a>
                    <a href="http://localhost:5192/swagger" target="_blank" rel="noopener">Swagger <span>↗</span></a>
                </div>
                <div class="build-stamp"><span>Scientific build</span><strong>v2.8 · 9.7 internal</strong></div>
            </div>
        </aside>

        <button class="sidebar-scrim" id="sidebarScrim" type="button" aria-label="Close navigation"></button>

        <div class="workspace-shell">
            <header class="topbar">
                <button class="mobile-menu-button" id="mobileMenuButton" type="button" aria-label="Open navigation"><span></span><span></span><span></span></button>
                <div class="page-heading"><span id="pageEyebrow">Workspace / Molecular studio</span><h1 id="pageTitle">Molecular studio</h1></div>
                <form class="global-molecule-search" id="globalMoleculeForm">
                    <label for="globalMoleculeInput">Molecule or bonded SMILES</label>
                    <div class="search-control">
                        <span class="search-glyph" aria-hidden="true">⌕</span>
                        <input id="globalMoleculeInput" value="@Model.Formula" autocomplete="off" spellcheck="false" />
                        <select id="globalShapeInput" aria-label="Geometry override">
                            <option value="Auto">Auto geometry</option><option value="Linear">Linear</option><option value="Bent">Bent</option>
                            <option value="TrigonalPlanar">Trigonal planar</option><option value="Tetrahedral">Tetrahedral</option>
                            <option value="TrigonalBipyramidal">Trigonal bipyramidal</option><option value="Octahedral">Octahedral</option>
                        </select>
                        <button type="submit" class="primary-button">Load</button>
                    </div>
                </form>
                <button type="button" class="theme-toggle quiet-button" id="themeToggleButton" aria-pressed="false" aria-label="Switch to dark theme">
                    <span id="themeToggleIcon" aria-hidden="true">☾</span>
                    <span class="theme-toggle-label" id="themeToggleLabel">Dark</span>
                </button>
                <div class="topbar-actions">
                    <button type="button" class="quiet-button" data-open-tool="formula-parse">Parse input</button>
                    <button type="button" class="primary-button" data-open-tool="physicochemical">Run profile</button>
                </div>
            </header>

            <main class="workspace-main">
                <section class="workspace-view is-active" id="view-studio" data-view="studio">
                    <div class="view-intro">
                        <div>
                            <span class="eyebrow">Current molecular context</span>
                            <h2><span id="currentMoleculeName">@Model.MoleculeName</span> <span class="formula-chip" id="currentFormulaBadge">@Model.ChemicalFormula</span></h2>
                            <p>Inspect geometry, switch representations, export structures, or continue directly into a scientific calculation.</p>
                        </div>
                        <div class="context-actions">
                            <button type="button" class="quiet-button" id="fitViewerButton">Fit view</button>
                            <button type="button" class="quiet-button" id="spinViewerButton">Rotate</button>
                            <button type="button" class="primary-button" data-open-tool="geometry">Geometry tools</button>
                        </div>
                    </div>

                    <div class="studio-grid">
                        <article class="viewer-card panel">
                            <div class="panel-header viewer-header">
                                <div class="segmented-control" role="tablist" aria-label="Molecular representation">
                                    <button class="is-active" type="button" data-visual-mode="3d">3D structure</button>
                                    <button type="button" data-visual-mode="2d">2D skeletal</button>
                                </div>
                                <div class="viewer-controls" id="viewer3dControls">
                                    <select id="spatialModeSelect" aria-label="Spatial mode"><option value="3d">Relaxed 3D</option><option value="flat">Planar coordinates</option></select>
                                    <select id="renderStyleSelect" aria-label="Render style"><option value="ballAndStick">Ball and stick</option><option value="stick">Stick</option><option value="sphere">Space filling</option><option value="wireframe">Wireframe</option></select>
                                    <select id="surfaceSelect" aria-label="Molecular surface"><option value="none">No surface</option><option value="vdw">van der Waals</option><option value="sas">Solvent accessible</option><option value="ses">Solvent excluded</option></select>
                                    <button type="button" class="icon-button" id="labelsViewerButton" aria-label="Toggle atom labels">Aa</button>
                                </div>
                                <div class="viewer-controls is-hidden" id="viewer2dControls"><button type="button" class="quiet-button" id="downloadSkeletalButton">Download SVG</button></div>
                            </div>
                            <div class="viewer-stage">
                                <div id="viewer3d" class="molecule-viewer" aria-label="Interactive 3D molecule"></div>
                                <div id="viewer2d" class="skeletal-viewer is-hidden"><div id="skeletalSvgContainer">@Html.Raw(Model.SkeletalSvgContent)</div></div>
                                <div class="viewer-watermark">Chemy molecular viewport</div>
                            </div>
                            <div class="viewer-footer">
                                <div class="viewer-legend"><span><i class="atom-dot carbon"></i> Carbon</span><span><i class="atom-dot oxygen"></i> Oxygen</span><span><i class="atom-dot nitrogen"></i> Nitrogen</span><span><i class="atom-dot hydrogen"></i> Hydrogen</span></div>
                                <div class="export-group"><span>Export</span><button type="button" data-download-format="mol">MOL</button><button type="button" data-download-format="pdb">PDB</button><button type="button" data-download-format="xyz">XYZ</button></div>
                            </div>
                        </article>

                        <aside class="studio-side">
                            <article class="panel identity-card">
                                <div class="panel-header"><div><span class="eyebrow">Molecular identity</span><h3>Current structure</h3></div><span class="scope-badge is-in-domain" id="structureScopeBadge">Loaded</span></div>
                                <dl class="metric-grid">
                                    <div><dt>Hill formula</dt><dd id="metaHillFormula">@Model.ChemicalFormula</dd></div>
                                    <div><dt>Molar mass</dt><dd><span id="metaMolarMass">@Model.MolecularWeight.ToString("F3")</span> <small>g/mol</small></dd></div>
                                    <div><dt>Atoms</dt><dd id="metaAtomCount">@Model.TotalAtomCount</dd></div>
                                    <div><dt>Geometry</dt><dd id="metaVseprShape">@Model.VseprShape</dd></div>
                                    <div><dt>Ideal angle</dt><dd><span id="metaBondAngle">@Model.IdealBondAngleDegrees.ToString("F1")</span><small>°</small></dd></div>
                                    <div><dt>Elements</dt><dd id="metaElements">@(string.Join(" · ", Model.ElementsPresent))</dd></div>
                                </dl>
                                <div class="tag-block">
                                    <span>Detected groups</span>
                                    <div id="metaFunctionalGroups">
                                        @if (Model.FunctionalGroups.Count == 0) { <span class="data-tag">None identified</span> }
                                        else { @foreach (var group in Model.FunctionalGroups) { <span class="data-tag">@group</span> } }
                                    </div>
                                </div>
                            </article>

                            <article class="panel quick-actions-card">
                                <div class="panel-header"><div><span class="eyebrow">Continue analysis</span><h3>Suggested tools</h3></div></div>
                                <button class="analysis-link" type="button" data-open-tool="physicochemical"><span class="analysis-icon blue">P</span><span><strong>Physicochemical profile</strong><small>TPSA, LogP, QED and filters</small></span><b>→</b></button>
                                <button class="analysis-link" type="button" data-open-tool="force-field"><span class="analysis-icon violet">F</span><span><strong>Force-field minimization</strong><small>Energy, convergence and geometry</small></span><b>→</b></button>
                                <button class="analysis-link" type="button" data-open-tool="spectroscopy"><span class="analysis-icon teal">S</span><span><strong>Spectroscopy estimate</strong><small>1H, 13C and IR correlations</small></span><b>→</b></button>
                            </article>

                            <article class="panel compound-card">
                                <div class="panel-header"><div><span class="eyebrow">Reference compounds</span><h3>Compound library</h3></div><span class="soft-count" id="compoundCount">20</span></div>
                                <label class="compact-search"><span>⌕</span><input id="compoundSearchInput" placeholder="Search compounds" /></label>
                                <div class="compound-list" id="compoundList"></div>
                            </article>
                        </aside>
                    </div>
                </section>

                <section class="workspace-view" id="view-tools" data-view="tools">
                    <div class="view-intro tools-intro">
                        <div><span class="eyebrow">Complete API workspace</span><h2>Calculation tools</h2><p>Every Chemy API capability is available here, grouped by scientific workflow rather than endpoint naming.</p></div>
                        <div class="coverage-summary"><strong>24</strong><span>API actions<br />available</span></div>
                    </div>

                    <div class="tools-layout">
                        <aside class="tool-directory panel">
                            <label class="compact-search tool-search"><span>⌕</span><input id="toolSearchInput" placeholder="Find a calculation" /></label>
                            <div class="tool-group" data-tool-group="Structure">
                                <p>Structure and data</p>
                                <button class="tool-nav-item" type="button" data-tool-target="periodic-table"><span>PT</span><b>Periodic table</b><small>2 actions</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="formula-parse"><span>Fx</span><b>Formula tools</b><small>2 actions</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="smiles-parse"><span>Sm</span><b>SMILES parser</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="geometry"><span>3D</span><b>Geometry studio</b><small>3 actions</small></button>
                            </div>
                            <div class="tool-group" data-tool-group="Reactions">
                                <p>Reactions and thermodynamics</p>
                                <button class="tool-nav-item" type="button" data-tool-target="reactions"><span>Rx</span><b>Reaction workspace</b><small>3 actions</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="thermodynamics"><span>ΔG</span><b>Thermodynamics</b><small>1 action</small></button>
                            </div>
                            <div class="tool-group" data-tool-group="Physical">
                                <p>Physical chemistry</p>
                                <button class="tool-nav-item" type="button" data-tool-target="ph"><span>pH</span><b>Acid equilibrium</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="buffer"><span>HA</span><b>Buffer system</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="nernst"><span>E</span><b>Nernst potential</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="kinetics"><span>k</span><b>Kinetics</b><small>2 actions</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="force-field"><span>FF</span><b>Force field</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="huckel"><span>Ψ</span><b>Hückel orbitals</b><small>1 action</small></button>
                            </div>
                            <div class="tool-group" data-tool-group="Models">
                                <p>Models and exploration</p>
                                <button class="tool-nav-item" type="button" data-tool-target="spectroscopy"><span>δ</span><b>Spectroscopy</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="physicochemical"><span>Pc</span><b>Physicochemical</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="pubchem"><span>Db</span><b>PubChem</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="evolution"><span>Ex</span><b>Graph exploration</b><small>1 action</small></button>
                                <button class="tool-nav-item" type="button" data-tool-target="ecoclean"><span>Ec</span><b>EcoClean</b><small>1 action</small></button>
                            </div>
                        </aside>

                        <div class="tool-stage">
                            <div class="tool-empty-state panel" id="toolEmptyState"><span class="empty-orbit">+</span><h3>Select a calculation</h3><p>Choose a tool from the directory. Inputs, scientific scope, and results stay together in one focused view.</p></div>

                            <article class="tool-panel panel" data-tool-panel="periodic-table">
                                <div class="tool-heading"><div><span class="eyebrow">Reference data</span><h2>Periodic table</h2><p>Browse all elements or resolve one element by symbol, name, or atomic number.</p></div><span class="method-badge exact">Reference table</span></div>
                                <form id="periodicTableForm" class="tool-form">
                                    <div class="field-row single-action-row">
                                        <label><span>Element query</span><input name="query" value="Au" placeholder="Au, Gold, or 79" /></label>
                                        <button class="primary-button" type="button" data-api-action data-form="periodicTableForm" data-endpoint="/api/v1/elements/{query}" data-path-input="query" data-output="periodicTableOutput">Find element</button>
                                        <button class="quiet-button" type="button" data-api-action data-endpoint="/api/v1/elements" data-output="periodicTableOutput">Load all</button>
                                    </div>
                                </form>
                                <div class="result-panel" id="periodicTableOutput" data-empty="Results appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="formula-parse">
                                <div class="tool-heading"><div><span class="eyebrow">Composition</span><h2>Formula tools</h2><p>Parse empirical composition or generate the API molecule diagram.</p></div><span class="method-badge exact">Deterministic</span></div>
                                <form id="formulaForm" class="tool-form">
                                    <div class="field-grid two"><label><span>Formula</span><input name="formula" value="Fe2(SO4)3*5H2O" /></label><label><span>Name <small>optional</small></span><input name="name" value="Iron(III) sulfate pentahydrate" /></label></div>
                                    <div class="form-actions">
                                        <button class="primary-button" type="button" data-api-action data-form="formulaForm" data-endpoint="/api/v1/molecules/parse" data-output="formulaOutput">Parse formula</button>
                                        <button class="quiet-button" type="button" data-api-action data-form="formulaForm" data-endpoint="/api/v1/molecules/svg?isDarkMode=false" data-output="formulaOutput" data-render="svg">Render molecule SVG</button>
                                    </div>
                                </form>
                                <div class="result-panel" id="formulaOutput" data-empty="Composition or SVG output appears here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="smiles-parse">
                                <div class="tool-heading"><div><span class="eyebrow">Bonded topology</span><h2>SMILES parser</h2><p>Parse a supported bonded organic structure and inspect atoms, bonds, groups, and canonical properties.</p></div><span class="method-badge bounded">Bounded parser</span></div>
                                <form id="smilesForm" class="tool-form">
                                    <div class="field-grid two"><label><span>Bonded SMILES</span><input name="smiles" value="CC(=O)Oc1ccccc1C(=O)O" /></label><label><span>Name <small>optional</small></span><input name="name" value="Aspirin" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="smilesForm" data-endpoint="/api/v1/smiles/parse" data-output="smilesOutput">Parse structure</button></div>
                                </form>
                                <div class="result-panel" id="smilesOutput" data-empty="Parsed topology appears here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="geometry">
                                <div class="tool-heading"><div><span class="eyebrow">Coordinates and diagrams</span><h2>Geometry studio</h2><p>Generate relaxed 3D, planar coordinates, or a 2D skeletal diagram and load the result into the studio.</p></div><span class="method-badge numerical">Numerical</span></div>
                                <form id="geometryForm" class="tool-form">
                                    <div class="field-grid three"><label><span>Molecule or SMILES</span><input name="formula" value="CCO" data-current-molecule /></label><label><span>Name <small>optional</small></span><input name="name" value="Ethanol" /></label><label><span>Shape override</span><select name="overrideShape"><option value="">Auto</option><option>Linear</option><option>Bent</option><option>TrigonalPlanar</option><option>Tetrahedral</option><option>Octahedral</option></select></label></div>
                                    <div class="form-actions">
                                        <button class="primary-button" type="button" data-api-action data-form="geometryForm" data-endpoint="/api/v1/geometry/3d" data-output="geometryOutput" data-render="geometry">Generate 3D</button>
                                        <button class="quiet-button" type="button" data-api-action data-form="geometryForm" data-endpoint="/api/v1/geometry/planar-3d" data-output="geometryOutput" data-render="geometry-planar">Generate planar</button>
                                        <button class="quiet-button" type="button" data-api-action data-form="geometryForm" data-endpoint="/api/v1/geometry/skeletal-2d" data-output="geometryOutput" data-render="svg">Render skeletal 2D</button>
                                    </div>
                                </form>
                                <div class="result-panel" id="geometryOutput" data-empty="Coordinates, diagnostics, or skeletal output appears here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="reactions">
                                <div class="tool-heading"><div><span class="eyebrow">Stoichiometry</span><h2>Reaction workspace</h2><p>Balance a reaction, request an explanation, or render a reaction diagram.</p></div><span class="method-badge exact">Exact algebra</span></div>
                                <form id="reactionForm" class="tool-form">
                                    <label class="wide-field"><span>Reaction equation</span><input name="equation" value="Fe + O2 -> Fe2O3" /></label>
                                    <div class="form-actions">
                                        <button class="primary-button" type="button" data-api-action data-form="reactionForm" data-endpoint="/api/v1/reactions/balance" data-output="reactionOutput">Balance</button>
                                        <button class="quiet-button" type="button" data-api-action data-form="reactionForm" data-endpoint="/api/v1/reactions/explain" data-output="reactionOutput">Explain steps</button>
                                        <button class="quiet-button" type="button" data-api-action data-form="reactionForm" data-endpoint="/api/v1/reactions/svg?isDarkMode=false" data-output="reactionOutput" data-render="svg">Render SVG</button>
                                    </div>
                                </form>
                                <div class="result-panel" id="reactionOutput" data-empty="Balanced coefficients, explanation, or diagram appears here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="thermodynamics">
                                <div class="tool-heading"><div><span class="eyebrow">Standard-state chemistry</span><h2>Reaction thermodynamics</h2><p>Evaluate supported reactions at the declared 298.15 K standard-state boundary.</p></div><span class="method-badge exact">Reference equation</span></div>
                                <form id="thermoForm" class="tool-form">
                                    <div class="field-grid two-one"><label><span>Balanced equation</span><input name="equation" value="CH4 + 2O2 -> CO2 + 2H2O" /></label><label><span>Temperature (K)</span><input name="temperatureKelvin" type="number" data-value-type="number" value="298.15" step="0.01" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="thermoForm" data-endpoint="/api/v1/reactions/thermodynamics" data-output="thermoOutput">Calculate thermodynamics</button></div>
                                </form>
                                <div class="result-panel" id="thermoOutput" data-empty="Thermodynamic state functions appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="ph">
                                <div class="tool-heading"><div><span class="eyebrow">Aqueous equilibrium</span><h2>Acid pH</h2><p>Calculate strong-acid pH or supply Ka for the weak-acid cubic equilibrium.</p></div><span class="method-badge exact">Exact / root solve</span></div>
                                <form id="phForm" class="tool-form">
                                    <div class="field-grid two"><label><span>Concentration (mol/L)</span><input name="concentrationMolar" type="number" data-value-type="number" value="0.1" step="0.001" /></label><label><span>Ka <small>leave blank for strong acid</small></span><input name="ka" type="number" data-value-type="number" value="1.8e-5" step="0.000001" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="phForm" data-endpoint="/api/v1/solutions/ph" data-output="phOutput">Calculate pH</button></div>
                                </form>
                                <div class="result-panel" id="phOutput" data-empty="pH and numerical diagnostics appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="buffer">
                                <div class="tool-heading"><div><span class="eyebrow">Aqueous equilibrium</span><h2>Buffer system</h2><p>Apply the Henderson–Hasselbalch relationship to an ideal acid/conjugate-base pair.</p></div><span class="method-badge exact">Exact equation</span></div>
                                <form id="bufferForm" class="tool-form">
                                    <div class="field-grid three"><label><span>pKa</span><input name="pka" type="number" data-value-type="number" value="4.76" step="0.01" /></label><label><span>Acid (mol/L)</span><input name="acidConcentrationMolar" type="number" data-value-type="number" value="0.1" step="0.01" /></label><label><span>Conjugate base (mol/L)</span><input name="conjugateBaseConcentrationMolar" type="number" data-value-type="number" value="0.1" step="0.01" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="bufferForm" data-endpoint="/api/v1/solutions/buffer" data-output="bufferOutput">Calculate buffer</button></div>
                                </form>
                                <div class="result-panel" id="bufferOutput" data-empty="Buffer pH and capacity appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="nernst">
                                <div class="tool-heading"><div><span class="eyebrow">Electrochemistry</span><h2>Nernst potential</h2><p>Calculate non-standard reversible cell potential from E°, electron count, Q, and temperature.</p></div><span class="method-badge exact">Exact equation</span></div>
                                <form id="nernstForm" class="tool-form">
                                    <div class="field-grid four"><label><span>E° (V)</span><input name="standardCellPotentialVolts" type="number" data-value-type="number" value="1.10" step="0.01" /></label><label><span>Electrons</span><input name="electronsTransferred" type="number" data-value-type="integer" value="2" step="1" /></label><label><span>Reaction quotient Q</span><input name="reactionQuotientQ" type="number" data-value-type="number" value="0.01" step="0.01" /></label><label><span>Temperature (K)</span><input name="temperatureKelvin" type="number" data-value-type="number" value="298.15" step="0.01" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="nernstForm" data-endpoint="/api/v1/electrochemistry/nernst" data-output="nernstOutput">Calculate potential</button></div>
                                </form>
                                <div class="result-panel" id="nernstOutput" data-empty="Cell potential appears here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="kinetics">
                                <div class="tool-heading"><div><span class="eyebrow">Reaction rates</span><h2>Kinetics</h2><p>Evaluate Arrhenius k(T) or integrate a consecutive A → B → C network.</p></div><span class="method-badge numerical">Equation / RK4</span></div>
                                <div class="split-calculators">
                                    <form id="arrheniusForm" class="tool-form sub-calculator">
                                        <h3>Arrhenius rate</h3>
                                        <label><span>Pre-exponential factor A</span><input name="preExponentialFactorA" type="number" data-value-type="number" value="1e13" /></label>
                                        <label><span>Activation energy (kJ/mol)</span><input name="activationEnergykJPerMol" type="number" data-value-type="number" value="75" /></label>
                                        <label><span>Temperature (K)</span><input name="temperatureKelvin" type="number" data-value-type="number" value="298.15" /></label>
                                        <button class="primary-button" type="button" data-api-action data-form="arrheniusForm" data-endpoint="/api/v1/kinetics/arrhenius" data-output="kineticsOutput">Calculate k(T)</button>
                                    </form>
                                    <form id="networkForm" class="tool-form sub-calculator">
                                        <h3>Consecutive network</h3>
                                        <div class="field-grid two"><label><span>Initial A (M)</span><input name="initialConcA" type="number" data-value-type="number" value="1" /></label><label><span>Steps</span><input name="steps" type="number" data-value-type="integer" value="50" /></label></div>
                                        <div class="field-grid three"><label><span>k1</span><input name="k1" type="number" data-value-type="number" value="0.5" /></label><label><span>k2</span><input name="k2" type="number" data-value-type="number" value="0.2" /></label><label><span>Time (s)</span><input name="totalTime" type="number" data-value-type="number" value="10" /></label></div>
                                        <button class="primary-button" type="button" data-api-action data-form="networkForm" data-endpoint="/api/v1/kinetics/network" data-output="kineticsOutput" data-render="network">Simulate network</button>
                                    </form>
                                </div>
                                <div class="result-panel" id="kineticsOutput" data-empty="Rate or concentration trajectory appears here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="force-field">
                                <div class="tool-heading"><div><span class="eyebrow">Molecular mechanics</span><h2>Force-field minimization</h2><p>Relax a supported molecule with the UFF-compatible organic subset and inspect convergence diagnostics.</p></div><span class="method-badge empirical">Empirical model</span></div>
                                <form id="forceFieldForm" class="tool-form">
                                    <div class="field-grid three"><label><span>Molecule or SMILES</span><input name="formula" value="H2O" data-current-molecule /></label><label><span>Shape override</span><input name="overrideShape" placeholder="Auto" /></label><label><span>Maximum iterations</span><input name="maxIterations" type="number" data-value-type="integer" value="500" min="1" max="2000" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="forceFieldForm" data-endpoint="/api/v1/physics/minimize" data-output="forceFieldOutput" data-render="geometry">Minimize energy</button></div>
                                </form>
                                <div class="result-panel" id="forceFieldOutput" data-empty="Energy, coordinates, applicability, and convergence appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="huckel">
                                <div class="tool-heading"><div><span class="eyebrow">Electronic structure</span><h2>Hückel molecular orbitals</h2><p>Analyze a supported conjugated π-system with the semi-empirical HMO Hamiltonian.</p></div><span class="method-badge empirical">Semi-empirical</span></div>
                                <form id="huckelForm" class="tool-form">
                                    <div class="field-grid two-one"><label><span>Conjugated SMILES</span><input name="formula" value="c1ccccc1" data-current-molecule /></label><label><span>|β| (eV)</span><input name="betaEv" type="number" data-value-type="number" value="2.71" step="0.01" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="huckelForm" data-endpoint="/api/v1/quantum/huckel" data-output="huckelOutput">Calculate orbitals</button></div>
                                </form>
                                <div class="result-panel" id="huckelOutput" data-empty="Orbital energies and reactivity indices appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="spectroscopy">
                                <div class="tool-heading"><div><span class="eyebrow">Empirical correlations</span><h2>Spectroscopy estimate</h2><p>Estimate 1H NMR, 13C NMR, and IR features for a supported bonded molecule.</p></div><span class="method-badge empirical">Empirical / heuristic</span></div>
                                <form id="spectroscopyForm" class="tool-form">
                                    <label class="wide-field"><span>Bonded molecule or SMILES</span><input name="formula" value="CC(=O)C" data-current-molecule /></label>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="spectroscopyForm" data-endpoint="/api/v1/spectroscopy/predict" data-output="spectroscopyOutput" data-render="spectroscopy">Estimate spectrum</button></div>
                                </form>
                                <div class="result-panel" id="spectroscopyOutput" data-empty="Estimated peaks, bands, evidence, and scope appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="physicochemical">
                                <div class="tool-heading"><div><span class="eyebrow">Molecular descriptors</span><h2>Physicochemical profile</h2><p>Calculate molecular weight, TPSA, LogP, QED, H-bonding, and common drug-likeness filters.</p></div><span class="method-badge empirical">Calibrated subset</span></div>
                                <form id="physicochemicalForm" class="tool-form">
                                    <label class="wide-field"><span>Bonded molecule or SMILES</span><input name="formula" value="CC(=O)Oc1ccccc1C(=O)O" data-current-molecule /></label>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="physicochemicalForm" data-endpoint="/api/v1/pharmacology/admet" data-output="physicochemicalOutput">Calculate profile</button></div>
                                </form>
                                <div class="result-panel" id="physicochemicalOutput" data-empty="Descriptors, filters, calibration, and applicability appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="pubchem">
                                <div class="tool-heading"><div><span class="eyebrow">External reference</span><h2>PubChem lookup</h2><p>Query the live NCBI PubChem PUG REST service by compound name or CID.</p></div><span class="method-badge external">Live external data</span></div>
                                <form id="pubchemForm" class="tool-form">
                                    <div class="field-row single-action-row"><label><span>Name or CID</span><input name="query" value="Aspirin" /></label><button class="primary-button" type="button" data-api-action data-form="pubchemForm" data-endpoint="/api/v1/cloud/pubchem/{query}" data-path-input="query" data-output="pubchemOutput" data-render="pubchem">Search PubChem</button></div>
                                </form>
                                <div class="result-panel" id="pubchemOutput" data-empty="Compound identity and canonical structure appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="evolution">
                                <div class="tool-heading"><div><span class="eyebrow">Graph hypotheses</span><h2>Rule-based molecular exploration</h2><p>Generate bounded graph mutations and rank them by implemented physicochemical descriptors.</p></div><span class="method-badge heuristic">Heuristic</span></div>
                                <form id="evolutionForm" class="tool-form">
                                    <div class="field-grid two-one"><label><span>Bonded SMILES</span><input name="input" value="CC(=O)Oc1ccccc1C(=O)O" data-current-molecule /></label><label><span>Generations</span><input name="generations" type="number" data-value-type="integer" value="50" min="1" max="100" /></label></div>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="evolutionForm" data-endpoint="/api/v1/evolution/evolve" data-output="evolutionOutput">Explore candidates</button></div>
                                </form>
                                <div class="scope-notice">Candidate ranking is not evidence of potency, safety, metabolism, or synthesis feasibility.</div>
                                <div class="result-panel" id="evolutionOutput" data-empty="Ranked structural hypotheses appear here"></div>
                            </article>

                            <article class="tool-panel panel" data-tool-panel="ecoclean">
                                <div class="tool-heading"><div><span class="eyebrow">Environmental hypotheses</span><h2>EcoClean pathway</h2><p>Construct a qualitative bond-cleavage pathway using characteristic BDEs and rule-based catalyst labels.</p></div><span class="method-badge heuristic">Qualitative</span></div>
                                <form id="ecocleanForm" class="tool-form">
                                    <label class="wide-field"><span>Pollutant name, formula, or supported structure</span><input name="pollutant" value="PFOA C8HF15O2" /></label>
                                    <div class="form-actions"><button class="primary-button" type="button" data-api-action data-form="ecocleanForm" data-endpoint="/api/v1/environmental/ecoclean" data-output="ecocleanOutput">Generate hypothesis</button></div>
                                </form>
                                <div class="scope-notice">This output does not calculate degradation kinetics, yield, mineralization efficiency, or environmental safety.</div>
                                <div class="result-panel" id="ecocleanOutput" data-empty="A qualitative pathway hypothesis appears here"></div>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="workspace-view" id="view-docs" data-view="docs">
                    <div class="view-intro"><div><span class="eyebrow">Knowledge base</span><h2>Documentation</h2><p>Navigate by task, implementation detail, or scientific evidence without leaving the workspace.</p></div></div>
                    <div class="knowledge-layout">
                        <aside class="document-directory panel" id="documentDirectory">
                            <button type="button" class="doc-nav-item is-active" data-doc-key="home"><strong>Documentation home</strong><small>Choose a path</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="started"><strong>Getting started</strong><small>Install and run</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="cookbook"><strong>Cookbook</strong><small>Task-oriented C#</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="api"><strong>API reference</strong><small>Types and routes</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="arch"><strong>Architecture</strong><small>Components and flow</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="science"><strong>Scientific approach</strong><small>Methods and equations</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="credibility"><strong>Credibility report</strong><small>Current boundaries</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="benchmarks"><strong>Verification</strong><small>Evidence and metrics</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="audit"><strong>Audit v2.8</strong><small>Current verdict</small></button>
                            <button type="button" class="doc-nav-item" data-doc-key="showcase"><strong>Use cases</strong><small>Illustrative workflows</small></button>
                        </aside>
                        <article class="document-viewer panel">
                            <div class="document-toolbar"><span id="documentTitle">Documentation home</span><button type="button" class="quiet-button" id="scrollDocumentTop">Back to top</button></div>
                            <div class="markdown-body" id="documentContent"></div>
                        </article>
                    </div>
                </section>

                <section class="workspace-view" id="view-code" data-view="code">
                    <div class="view-intro">
                        <div><span class="eyebrow">Live assembly metadata</span><h2>C# code reference</h2><p>Search the public Chemy.Core surface extracted from XML documentation and reflection.</p></div>
                        <label class="reference-search"><span>⌕</span><input id="codeSearchInput" placeholder="Search types, methods, or summaries" /></label>
                    </div>
                    <div class="code-reference-grid" id="codeReferenceGrid">
                        @foreach (var cls in Model.ClassDocumentationList)
                        {
                            <details class="code-card panel" data-code-search="@(string.Concat(cls.Name, " ", cls.Namespace, " ", cls.Summary).ToLowerInvariant())">
                                <summary><span class="type-mark">C#</span><span><strong>@cls.Name</strong><small>@cls.Namespace</small></span><span class="soft-count">@(cls.Methods.Count + cls.Properties.Count)</span></summary>
                                <div class="code-card-body">
                                    <p>@cls.Summary</p>
                                    @if (cls.Properties.Any()) { <h4>Properties</h4> @foreach (var property in cls.Properties) { <div class="member-row"><code>@property.Signature</code><span>@property.Summary</span></div> } }
                                    @if (cls.Methods.Any()) { <h4>Methods</h4> @foreach (var method in cls.Methods) { <div class="member-row"><code>@method.Signature</code><span>@method.Summary</span></div> } }
                                </div>
                            </details>
                        }
                    </div>
                </section>

                <section class="workspace-view" id="view-scope" data-view="scope">
                    <div class="view-intro"><div><span class="eyebrow">Scientific governance</span><h2>Scope and evidence</h2><p>A concise operating guide for interpreting Chemy outputs safely and accurately.</p></div><span class="readiness-score"><strong>9.7</strong><small>/ 10 internal readiness</small></span></div>
                    <div class="scope-grid">
                        <article class="panel scope-hero">
                            <span class="eyebrow">Decision rule</span><h3>Use the result contract, not the feature name.</h3>
                            <p>Scientific outputs identify their method, evidence class, applicability, uncertainty, or numerical diagnostics. Out-of-domain predictive inputs fail closed instead of returning an unjustified number.</p>
                            <div class="scope-legend"><span><i class="scope-dot exact"></i><b>Exact equation</b><small>Analytical or rational result</small></span><span><i class="scope-dot numerical"></i><b>Numerical</b><small>Inspect convergence and residuals</small></span><span><i class="scope-dot empirical"></i><b>Empirical</b><small>Inspect domain and calibration</small></span><span><i class="scope-dot heuristic"></i><b>Heuristic</b><small>Expert-review hypothesis</small></span></div>
                        </article>
                        <article class="panel certification-card"><span class="eyebrow">Reserved certification evidence</span><h3>The final 0.3 is external.</h3><ol><li><span>01</span>Prospectively freeze cases and thresholds.</li><li><span>02</span>Independently curate and reproduce results.</li><li><span>03</span>Obtain identifiable chemistry-domain review.</li></ol></article>
                        <article class="panel boundary-card"><span class="boundary-index">A</span><h3>Physicochemical descriptors</h3><p>TPSA, LogP, QED, and filters are bounded descriptors—not ADME, safety, efficacy, or clinical predictions.</p></article>
                        <article class="panel boundary-card"><span class="boundary-index">B</span><h3>Molecular mechanics</h3><p>UFF compatibility is demonstrated for the declared atom-type subset and pinned cases, not universal chemistry.</p></article>
                        <article class="panel boundary-card"><span class="boundary-index">C</span><h3>Spectroscopy</h3><p>The 1H calibration is narrow; 13C and IR remain heuristic correlation estimates.</p></article>
                        <article class="panel boundary-card"><span class="boundary-index">D</span><h3>Exploration tools</h3><p>Evolution and EcoClean generate hypotheses. They do not establish synthesis, biological activity, degradation yield, or safety.</p></article>
                    </div>
                </section>
            </main>
        </div>
    </div>
    <div class="toast-region" id="toastRegion" aria-live="polite"></div>
</body>
</html>
