        function switchToolTab(tabName) {
            const tabs = ['balancer', 'huckel', 'thermo', 'ph', 'nernst', 'kinetics', 'spec', 'forcefield', 'pubchem', 'evolver', 'admet', 'ecoclean'];
            tabs.forEach(t => {
                const pane = document.getElementById(`pane-${t}`);
                const btn = document.getElementById(`ttab-${t}`);
                if (pane) pane.classList.add('hidden');
                if (btn) {
                    btn.classList.remove('bg-sky-600', 'text-white');
                    btn.classList.add('bg-slate-800', 'text-slate-300');
                }
            });
            const targetPane = document.getElementById(`pane-${tabName}`);
            const targetBtn = document.getElementById(`ttab-${tabName}`);
            if (targetPane) targetPane.classList.remove('hidden');
            if (targetBtn) {
                targetBtn.classList.add('bg-sky-600', 'text-white');
                targetBtn.classList.remove('bg-slate-800', 'text-slate-300');
            }
        }

        async function runBalancer() {
            const eq = document.getElementById('balancerEquationInput').value;
            const out = document.getElementById('balancerOutput');
            out.innerHTML = '<span class="text-sky-400">Computing exact rational nullspace...</span>';

            try {
                const res = await fetch('/api/v1/reactions/balance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ equation: eq })
                });
                const data = await res.json();
                if (res.ok) {
                    out.innerHTML = `
                        <div class="text-emerald-400 font-bold">Balanced: ${data.balanced}</div>
                        <div class="text-slate-400 text-[10px] pt-1">Reactants: ${data.reactants.map(r => r.coefficient + r.chemicalFormula).join(' + ')} -> Products: ${data.products.map(p => p.coefficient + p.chemicalFormula).join(' + ')}</div>
