        function copyCode(elementId) {
            const text = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(text);
            alert('Code snippet copied to clipboard!');
        }

        function setCodeLang(lang) {
            document.getElementById('clang-csharp').classList.toggle('bg-sky-600', lang === 'csharp');
            document.getElementById('clang-csharp').classList.toggle('text-white', lang === 'csharp');
            document.getElementById('clang-csharp').classList.toggle('bg-slate-800', lang !== 'csharp');

            document.getElementById('clang-curl').classList.toggle('bg-sky-600', lang === 'curl');
            document.getElementById('clang-curl').classList.toggle('text-white', lang === 'curl');
            document.getElementById('clang-curl').classList.toggle('bg-slate-800', lang !== 'curl');
        }

        function setCodeRefSubView(mode) {
            const isClasses = mode === 'classes';
            document.getElementById('crpane-classes').classList.toggle('hidden', !isClasses);
            document.getElementById('crpane-snippets').classList.toggle('hidden', isClasses);

            const btnClasses = document.getElementById('crsub-classes');
            const btnSnippets = document.getElementById('crsub-snippets');

            if (btnClasses && btnSnippets) {
                btnClasses.classList.toggle('bg-sky-600', isClasses);
                btnClasses.classList.toggle('text-white', isClasses);
                btnClasses.classList.toggle('bg-slate-800', !isClasses);
                btnClasses.classList.toggle('text-slate-300', !isClasses);

                btnSnippets.classList.toggle('bg-sky-600', !isClasses);
                btnSnippets.classList.toggle('text-white', !isClasses);
                btnSnippets.classList.toggle('bg-slate-800', isClasses);
                btnSnippets.classList.toggle('text-slate-300', isClasses);
            }
        }

        function filterCodeRef() {
            const query = (document.getElementById('codeRefSearchInput').value || '').toLowerCase().trim();
            const cards = document.querySelectorAll('.coderef-class-card');

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || '';
                const ns = card.getAttribute('data-namespace') || '';
                const summary = card.getAttribute('data-summary') || '';
                const text = card.textContent.toLowerCase();

                const match = !query || name.includes(query) || ns.includes(query) || summary.includes(query) || text.includes(query);
                card.style.display = match ? 'block' : 'none';
            });
        }

        function downloadFormat(ext) {
            let content = '';
            const isFlat = (currentSpatialMode === 'flat');
            const suffix = isFlat ? '_planar' : '';
            let filename = `@Model.ChemicalFormula${suffix}.${ext}`;

            if (ext === 'pdb') {
                content = document.getElementById(isFlat ? 'rawPlanarPdbData' : 'rawPdbData').value;
            } else if (ext === 'xyz') {
                content = document.getElementById(isFlat ? 'rawPlanarXyzData' : 'rawXyzData').value;
            } else if (ext === 'mol') {
                content = document.getElementById(isFlat ? 'rawPlanarMolData' : 'rawMolData').value || document.getElementById(isFlat ? 'rawPlanarPdbData' : 'rawPdbData').value;
            }

            const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = filename;
            a.click();
        }
    </script>
</body>
</html>
